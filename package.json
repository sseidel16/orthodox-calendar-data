{
  "name": "orthodox-calendar-data",
  "version": "1.0.0",
  "description": "Generates Orthodox calendar JSON data from CSV source files",
  "main": "dist/index.js",
  "browser": "dist/orthodox-calendar-data.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:browser": "node build-browser.mjs",
    "build:all": "tsc && node build-browser.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsc && node dist/cli.js",
    "cli:date": "tsc && node dist/cli.js date",
    "cli:range": "tsc && node dist/cli.js range",
    "cli:month": "tsc && node dist/cli.js month",
    "cli:year": "tsc && node dist/cli.js year",
    "generate": "tsc && node dist/cli.js year",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "orthodox",
    "calendar",
    "saints",
    "feasts"
  ],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "csv-parse": "5.6.0"
  }
}
